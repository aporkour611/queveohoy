{
  "regions": ["cdg1"],
  "functions": {
    "app/api/cron/route.ts": {
      "maxDuration": 120
    },
    "app/api/push/cron/route.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/push/cron",
      "schedule": "*/15 * * * *"
    }
  ]
}
