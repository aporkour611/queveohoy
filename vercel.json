{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": false
  },
  "regions": ["cdg1"],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.queveohoy.es" }],
      "destination": "https://queveohoy.es/:path*",
      "permanent": true
    }
  ],
  "functions": {
    "app/api/cron/route.ts": {
      "maxDuration": 120
    },
    "app/api/push/cron/route.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/push/cron",
      "schedule": "0 19 * * *"
    }
  ]
}
