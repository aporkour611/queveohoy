{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "fluid": true,
  "git": {
    "deploymentEnabled": false
  },
  "regions": ["cdg1"],
  "headers": [
    {
      "source": "/posters/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/deportes/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/api/feed-meta",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, s-maxage=60, stale-while-revalidate=120"
        }
      ]
    },
    {
      "source": "/api/home-feed",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=900, s-maxage=900, stale-while-revalidate=1800"
        }
      ]
    },
    {
      "source": "/api/v2/feed",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=900, s-maxage=900, stale-while-revalidate=1800"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Link",
          "value": "</deportes/ufc/topuria-lcp.webp>; rel=preload; as=image; fetchpriority=high"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "header", "key": "x-forwarded-proto", "value": "http" }],
      "destination": "https://queveohoy.es/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.queveohoy.es" }],
      "destination": "https://queveohoy.es/:path*",
      "permanent": true
    }
  ],
  "functions": {
    "app/api/cron/route.ts": {
      "maxDuration": 120,
      "memory": 3009
    },
    "app/api/push/cron/route.ts": {
      "maxDuration": 60
    },
    "app/api/warm/route.ts": {
      "maxDuration": 60,
      "memory": 3009
    },
    "app/api/health/route.ts": {
      "maxDuration": 60
    },
    "app/api/midnight-rollover/route.ts": {
      "maxDuration": 120,
      "memory": 3009
    }
  },
  "crons": [
    {
      "path": "/api/midnight-rollover",
      "schedule": "0 22 * * *"
    },
    {
      "path": "/api/midnight-rollover",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/warm",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron?phase=core",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron?phase=core",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron?phase=core",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron?phase=extended",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/cron?phase=extended",
      "schedule": "30 12 * * *"
    },
    {
      "path": "/api/cron?phase=extended",
      "schedule": "30 18 * * *"
    },
    {
      "path": "/api/push/cron",
      "schedule": "0 19 * * *"
    }
  ]
}
