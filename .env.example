# Copia a .env.local y rellena los valores.

# Sitio
NEXT_PUBLIC_SITE_URL=https://queveohoy.es

# Supabase (obligatorio)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Seguridad (obligatorio en producción; secretos distintos)
ADMIN_SECRET=
CRON_SECRET=

# APIs externas (cron)
FOOTBALL_DATA_API_KEY=
TMDB_API_KEY=

# IndexNow (obligatorio en producción; archivo en /public/{key}.txt)
INDEXNOW_KEY=

# Web Push (opcional)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contacto@queveohoy.es

# Vercel CLI (solo CI local)
# VERCEL_TOKEN=

# Debug (no usar en producción)
# ALLOW_DEBUG_ROUTES=true
