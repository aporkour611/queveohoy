# Copia a .env.local y rellena los valores.

# Sitio
NEXT_PUBLIC_SITE_URL=https://queveohoy.es

# Supabase (obligatorio)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Mismos valores sin NEXT_PUBLIC_ — el servidor los lee en runtime (deploy prebuilt en CI)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Solo scripts db:index (opcional)
# SUPABASE_DB_URL=

# Seguridad (obligatorio en producción; secretos distintos)
ADMIN_SECRET=
CRON_SECRET=

# Rate limit distribuido (opcional; recomendado en producción)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# APIs externas (cron)
FOOTBALL_DATA_API_KEY=
TMDB_API_KEY=
# PANDASCORE_API_KEY=
# BALLDONTLIE_API_KEY=

# IndexNow (obligatorio en producción)
# Debe coincidir con public/{INDEXNOW_KEY}.txt (ej. public/8f3c2e1d4b5a6978queveohoy.txt)
INDEXNOW_KEY=

# Asistente IA (opcional; sin key usa modo inteligente local)
# ASSISTANT_ENABLED=true  # requerido para POST /api/assistant (UI retirada por defecto)
OPENAI_API_KEY=

# Web Push (opcional)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contacto@queveohoy.es

# Vercel CLI + GitHub Actions deploy (obligatorio en CI)
# VERCEL_TOKEN=   → GitHub Secret, no .env.local

# GitHub Secrets (no van en .env.local — ver docs/SETUP-MANUAL-TU.md)
# SNYK_TOKEN=
# SONAR_TOKEN=
# LHCI_GITHUB_APP_TOKEN=

# Alertas cron (opcional; webhook Slack-compatible JSON { text: ... })
# CRON_ALERT_WEBHOOK_URL=
