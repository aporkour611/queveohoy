{
  "info": {
    "name": "QueveoHoy Perf",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://queveohoy.es" }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 200', () => pm.response.code === 200);",
              "pm.test('ok true', () => pm.response.json().ok === true);",
              "pm.test('latency < 600ms', () => pm.response.responseTime < 600);"
            ]
          }
        }
      ]
    },
    {
      "name": "API v1 feed",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": "{{baseUrl}}/api/v1/feed"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 200', () => pm.response.code === 200);",
              "pm.test('has events', () => Array.isArray(pm.response.json().events));",
              "pm.test('latency < 600ms', () => pm.response.responseTime < 600);"
            ]
          }
        }
      ]
    },
    {
      "name": "API v2 feed",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": "{{baseUrl}}/api/v2/feed"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 200 or 304', () => [200, 304].includes(pm.response.code));",
              "pm.test('latency < 600ms', () => pm.response.responseTime < 600);"
            ]
          }
        }
      ]
    },
    {
      "name": "API v1 search",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": "{{baseUrl}}/api/v1/search?q=futbol"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 200', () => pm.response.code === 200);",
              "pm.test('latency < 800ms', () => pm.response.responseTime < 800);"
            ]
          }
        }
      ]
    },
    {
      "name": "Home HTML",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 200', () => pm.response.code === 200);",
              "pm.test('latency < 1200ms', () => pm.response.responseTime < 1200);"
            ]
          }
        }
      ]
    }
  ]
}
